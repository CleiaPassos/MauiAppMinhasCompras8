<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras8.RelatorioPage"
             Title="Relatório">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Relatório de Compras por Categoria"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Confira os produtos e o total gasto em cada categoria:"
                FontSize="16" />

            <CollectionView x:Name="RelatorioCollection">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                            Padding="10"
                            Spacing="5">

                            <!-- Categoria -->
                            <Label
                                Text="{Binding Categoria}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <!-- Produtos -->
                            <CollectionView
                                ItemsSource="{Binding Produtos}"
                                SelectionMode="None">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>

                                        <HorizontalStackLayout
                                            Spacing="5">

                                            <Label
                                                Text="{Binding Descricao}"
                                                FontSize="16" />

                                            <Label
                                                Text="{Binding Quantidade, StringFormat='— {0} ×'}"
                                                FontSize="16" />

                                            <Label
                                                Text="{Binding Preco, StringFormat='R$ {0:F2} ='}"
                                                FontSize="16" />

                                            <Label
                                                Text="{Binding Total, StringFormat='R$ {0:F2}'}"
                                                FontSize="16"
                                                FontAttributes="Bold" />

                                        </HorizontalStackLayout>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                            </CollectionView>

                            <!-- Total da categoria -->
                            <Label
                                Text="{Binding Total, StringFormat='Total da categoria: R$ {0:F2}'}"
                                FontSize="17"
                                FontAttributes="Bold"
                                HorizontalOptions="End" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>